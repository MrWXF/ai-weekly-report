# AI Provider: anthropic (Anthropic 兼容代理) / dashscope (通义千问) / zhipu (智谱)
AI_PROVIDER=anthropic

# ===== 方式一：Anthropic 兼容代理（推荐，你已配置） =====
# 例如：https://llm.chinadaas.com
ANTHROPIC_BASE_URL=
# 例如：sk-eIxiVDtrvLRUMUTgH9qerA
ANTHROPIC_API_KEY=
# 例如：dashscope/qwen3.5-plus
ANTHROPIC_MODEL=dashscope/qwen3.5-plus

# ===== 方式二：通义千问 =====
# DASHSCOPE_API_KEY=

# ===== 方式三：智谱 AI =====
# ZHIPU_API_KEY=

# Supabase (optional for MVP, history uses localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
